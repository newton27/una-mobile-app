{
  "expo": {
    "name": "Man of Teal",
    "slug": "man-of-teal",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "manofteal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.manofteal.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocationWhenInUseUsageDescription": "The app uses your location so you can share your current location when posting content.",
        "NSCameraUsageDescription": "The app takes picture to publish it on the site or use for video chat",
        "NSPhotoLibraryAddUsageDescription": "The app can save photos to your photo gallery",
        "NSMicrophoneUsageDescription": "The app records video to publish it on the site or use it for video/audio chat"
      },
      "supportsTablet": true
    },
    "android": {
      "package": "com.manofteal.app",
      "adaptiveIcon": {
        "backgroundColor": "#007F89",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#007F89",
          "dark": {
            "backgroundColor": "#063B43"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
